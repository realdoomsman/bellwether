{
  "name": "bellwether",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,web -c yellow,cyan \"npm run dev -w @bellwether/engine\" \"npm run dev -w @bellwether/web\"",
    "build": "npm run build -w @bellwether/web",
    "start": "npm run start -w @bellwether/engine",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "railway": "^3.11.0",
    "typescript": "^5.9.2"
  }
}
