# Floor engine configuration. Copy to apps/engine/.env (loaded by `npm run dev` / `npm start`).
# Every variable is optional in paper mode; defaults are shown.

# ─── Mode & safety ────────────────────────────────────────────────────────────
# paper: real prices/metadata/quotes, every write simulated (refs are `paper:<id>`, never links).
# live:  signs real transactions. Requires PROTOCOL_PRIVATE_KEY and LIVE_CONFIRM=real-funds.
ENGINE_MODE=paper
# LIVE_CONFIRM=real-funds
# 0x-prefixed 32-byte hex. Live only; never commit it.
# PROTOCOL_PRIVATE_KEY=
# Floor's fee wallet: the address creators set as Creator wallet / Reward recipient.
# Live: derived from the key (must match if also set).
# Paper: optional. Unset = no wallet is published, registration/verification answer `wallet_not_configured`,
# and discovery is off (demo tokens still run).
# PROTOCOL_ADDRESS=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# SQLite file (WAL). `:memory:` for throwaway runs.
DB_PATH=data/floor.db
# Admin API bearer token (>= 24 chars). Unset = admin routes answer 403.
# ADMIN_TOKEN=
# New registrations go live immediately (true) or wait for admin approval (false).
AUTO_APPROVE=true
# Comma-separated allowed origins for the API, or * (the API is read-mostly and uses bearer auth, no cookies).
CORS_ORIGINS=*
# Public site origin for absolute social-card URLs (og:image etc.). Unset = taken from each request
# (X-Forwarded-Host/Proto when TRUST_PROXY=true).
# PUBLIC_URL=https://floor.fun
# Trust the first X-Forwarded-For hop for per-IP rate limiting (set behind a reverse proxy).
TRUST_PROXY=false
# Built web app served with SPA fallback when <dir>/index.html exists. Default: apps/web/dist.
# WEB_DIST=
# Paper only: seed 8 synthetic demo tokens that accrue synthetic fees (marked demo in the DB; the UI shows PAPER).
# Also shortens worker intervals and lowers BRIDGE_MIN_ETH to 0.01 unless those are set explicitly.
DEMO_SEED=false

# ─── $FLOOR ───────────────────────────────────────────────────────────────────
# Official $FLOOR token on Robinhood Chain. Unset = $FLOOR buyback budgets accumulate unspent.
# FLOOR_TOKEN_ADDRESS=

# ─── Networks ─────────────────────────────────────────────────────────────────
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_NETWORK=robinhood
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# HIP-3 builder dex that lists the equity perps.
HYPERLIQUID_DEX=xyz
# Live only: ETH(RHC) → USDC(Arbitrum) bridge API.
RELAY_API_URL=https://api.relay.link

# ─── Contracts ────────────────────────────────────────────────────────────────
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
UNISWAP_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
UNISWAP_QUOTER=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
ARBITRUM_USDC=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
PONS_FACTORY=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
PONS_LOCKER=0x736D76699C26D0d966744cAe304C000d471f7F35
LAUNCHHOOD_FACTORY=0x62B33A039D289CBDa50EbeB72Fe4261449E61Bcf
# Unset = resolved from the factory on-chain.
# LAUNCHHOOD_LOCKER=
HYPERLIQUID_BRIDGE=0x2Df1c51E09aECF9cacB7bc98cB1742757f163dF7

# ─── Risk ─────────────────────────────────────────────────────────────────────
# Perp order slippage, basis points.
SLIPPAGE_BPS=50
# DEX buyback slippage, basis points.
BUYBACK_SLIPPAGE_BPS=150
# Smallest pooled collateral worth opening a position for (USD).
MIN_COLLATERAL_USD=10
# Largest collateral a single pooled market position may use (USD).
MAX_POOL_COLLATERAL_USD=500
# Cap on collateral deployed across all positions (USD).
MAX_TOTAL_DEPLOYED_USD=1500
MAX_CONCURRENT_POSITIONS=3
# Reduce 50% when the mark is within this fraction of the entry→liquidation distance; close at half of it.
LIQUIDATION_BUFFER_PCT=0.15
# Realized + unrealized loss in one UTC day that switches the kill switch on (USD).
GLOBAL_DAILY_LOSS_USD=300
# Claim creator fees only once at least this much is claimable (ETH).
CLAIM_MIN_ETH=0.0005
# Smallest buyback worth a swap (ETH).
BUYBACK_MIN_ETH=0.0005
# Bridge trading ETH to USDC once at least this much is waiting (ETH). Default 0.05; 0.01 with DEMO_SEED.
# BRIDGE_MIN_ETH=0.05
# Max bridge price impact, fraction (0.01 = 1%).
BRIDGE_MAX_IMPACT_PCT=0.01
# ETH always kept on Robinhood Chain for gas (also the minimum wallet balance for live signing).
RHC_GAS_RESERVE_ETH=0.01
# Entry signal threshold before each strategy's bonus (-100..100).
BASE_SIGNAL_THRESHOLD=30
# Fee headroom kept in each token's budget when sizing an entry, basis points of notional.
FEE_BUFFER_BPS=20

# ─── Worker intervals (seconds; ±10% jitter, capped exponential backoff on errors) ─────
# Defaults shown; with DEMO_SEED: claimer 45, treasury 90, trader 60, guardian 20, buyback 60, reconciler 60.
# CLAIMER_INTERVAL_SEC=600
# TREASURY_INTERVAL_SEC=900
# TRADER_INTERVAL_SEC=120
# GUARDIAN_INTERVAL_SEC=45
# BUYBACK_INTERVAL_SEC=600
# DISCOVERY_INTERVAL_SEC=900
# RECONCILER_INTERVAL_SEC=300
